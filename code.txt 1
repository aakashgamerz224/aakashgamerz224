<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit with Aakash</title>
<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
    }
    #loadingScreen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: black;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5em;
        z-index: 9999;
    }
    #loadingScreen img {
        width: 200px;
        height: 200px;
        border-radius: 15px;
        object-fit: cover;
        margin-bottom: 20px;
    }
    #appContent {
        display: none;
        padding: 20px;
    }
</style>
</head>
<body>

<div id="loadingScreen">
    <img src="pic.jpg" alt="Aakash">
    <p>Loading Edit with Aakash...</p>
</div>

<div id="appContent">
    <h1>Welcome to Edit with Aakash</h1>
    <p>Edit your images like a pro!</p>
</div>

<script>
    setTimeout(() => {
        document.getElementById("loadingScreen").style.display = "none";
        document.getElementById("appContent").style.display = "block";
    }, 3000);
</script>

</body>
</html>
